# Copy this file to .env (it is gitignored) or set keys from the Settings page.
# Everything works without any keys (free mode). Keys only unlock the optional paid providers.

# Anthropic API (paid writer). Not needed if you use Claude Code (your subscription).
ANTHROPIC_API_KEY=

# ElevenLabs (paid voice, music, transcription, thumbnail images)
ELEVENLABS_API_KEY=

# Higgsfield (paid thumbnail images) from https://cloud.higgsfield.ai
HF_API_KEY=
HF_API_SECRET=

# Your Netlify website (netlify-site/README.md): where it is, and the secret from its environment variables.
# With both set, `start-online.bat` keeps the site's "Open my studio" button pointing at this PC.
STUDIO_NETLIFY_SITE=
STUDIO_LINK_SECRET=

# ---------------------------------------------------------------------------------------------
# Hosted website only (docker compose / STUDIO_MODE=hosted). Ignore these for the app on your PC.
# ---------------------------------------------------------------------------------------------
# Your domain (DNS A record pointing at the server). Caddy gets the HTTPS certificate for it.
STUDIO_DOMAIN=
# This email becomes the admin when it signs up (otherwise the very first account is admin).
STUDIO_ADMIN_EMAIL=
# Stripe (https://dashboard.stripe.com/apikeys). Start with test keys (sk_test_...). See DEPLOY.md.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_PACK=
# Optional: a cookies.txt export if YouTube blocks your server's IP (path inside the container, e.g. /data/cookies.txt)
STUDIO_YTDLP_COOKIES=
# Optional: how many accounts one network (IP) may create per day (default 3)
STUDIO_SIGNUPS_PER_IP=3

# --- YouTube upload (optional, free): an OAuth "Desktop app" client from your own Google Cloud project
# with the YouTube Data API v3 enabled. Then Settings > Connect YouTube on this PC.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
